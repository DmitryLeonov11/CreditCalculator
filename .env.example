# Скопируйте в .env и подставьте свои значения. Файл .env в репозиторий не попадает.
POSTGRES_PASSWORD=<пароль БД>
JWT_SIGNING_KEY=<случайная строка не короче 32 символов>
# Необязательно: порты на хосте, если 3000/5432/8080 уже заняты.
# FRONTEND_PORT=3001
# DB_PORT=5433
# API_PORT=8088
# Origin frontend для CORS; по умолчанию формируется из FRONTEND_PORT.
# FRONTEND_ORIGIN=https://frontend.example.com
# RabbitMQ
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# Redis
# REDIS_PORT=6379
# MinIO (S3-совместимое хранилище)
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# Мониторинг
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
