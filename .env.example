# Скопируйте в .env и подставьте свои значения. Файл .env в репозиторий не попадает.
POSTGRES_PASSWORD=<пароль БД>
JWT_SIGNING_KEY=<случайная строка не короче 32 символов>
# Необязательно: порты на хосте, если 3000/5432/8080 уже заняты.
# FRONTEND_PORT=3001
# DB_PORT=5433
# API_PORT=8088
# Origin frontend для CORS; по умолчанию формируется из FRONTEND_PORT.
# FRONTEND_ORIGIN=https://frontend.example.com
