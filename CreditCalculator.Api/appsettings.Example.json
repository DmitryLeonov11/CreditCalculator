{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=creditcalculator;Username=creditcalculator;Password=<пароль БД>"
  },
  "Jwt": {
    "Issuer": "CreditCalculator",
    "Audience": "CreditCalculator",
    "SigningKey": "<случайная строка не короче 32 символов>",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "PublicUrl": {
    "BaseUrl": "https://<внешний адрес API>"
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Seed": {
    "EmployeeEmail": "employee@creditcalculator.local",
    "EmployeePassword": "<пароль тестового сотрудника>"
  }
}
