{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "CreditCalculator",
    "Audience": "CreditCalculator",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "PublicUrl": {
    "BaseUrl": ""
  },
  "Scoring": {
    "MinimumLivingWageByn": 500,
    "BelarusianGoodsPdnThreshold": 0.50
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Nbrb": {
    "BaseUrl": "https://www.nbrb.by/api",
    "Enabled": true,
    "UpdateIntervalHours": 6
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "DefaultExpiryMinutes": 60
  },
  "S3": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "creditcalculator-documents"
  }
}
